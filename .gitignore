# vim-plug itself -- installed per-machine into this dir, see README.
autoload/plug.vim

# Plugins live in stdpath('data')/plugged (see plugins.vim), not here -- listed
# only so a stray install into the old location never gets committed.
autoload/plugged/

# Runtime state written by plugins, all under stdpath('data'|'state'):
#   themery/state.json, auto-session sessions, restart-skip-autosession
# Nothing of it belongs in the config, but guard the legacy paths anyway.
session*.vim
*.swp
*.swo
tags

# macOS
.DS_Store

# Claude Code
CLAUDE.md
.claude/settings.local.json
